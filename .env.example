# ── AgentiCubed environment template ──────────────────────────────────────
# Copy to .env and fill in. NEVER commit a real .env. Secrets are referenced by
# KEY from agent/tool config; the values live here (or a secrets manager) only.

# Core
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-32+chars-min-for-jwt-signing
# 12h login sessions for local development; shorten for shared deployments
# (.env.prod.example keeps the strict 15-minute default).
ACCESS_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_SECONDS=1209600
# Comma-separated allowed origins ("*" for local dev only). The app refuses to
# start in production (ENVIRONMENT=production) if SECRET_KEY is left at default.
CORS_ORIGINS=*

# Database (PostgreSQL)
POSTGRES_USER=agenticubed
POSTGRES_PASSWORD=agenticubed
POSTGRES_DB=agenticubed
POSTGRES_HOST=db
POSTGRES_PORT=5432
# SQLAlchemy URL (async). Compose overrides host to the service name.
DATABASE_URL=postgresql+asyncpg://agenticubed:agenticubed@db:5432/agenticubed
# Sync URL used by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg://agenticubed:agenticubed@db:5432/agenticubed

# Redis (Celery broker + result backend)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Live event stream: "memory" (single process/dev) or "redis" (multi-process)
EVENT_BUS_BACKEND=memory

# Task dispatch: "inline" runs in the API request (dev/tests); "celery" queues
# to the worker so dispatch returns before execution (compose sets celery).
WORKFLOW_ENGINE_BACKEND=inline

# Artifact storage (local fs adapter for MVP)
ARTIFACT_STORE_BACKEND=local
ARTIFACT_STORE_PATH=/var/artifacts

# Model providers (referenced by KEY from agent config — never inline in prompts)
# Leave blank to use the deterministic MockProvider.
ANTHROPIC_API_KEY=
DEFAULT_PROVIDER=mock

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
