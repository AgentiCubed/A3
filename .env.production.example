# AgentiCubed single-node production template.
#
# Copy to .env.production, chmod 600, and replace every required value.
# This file is safe to commit because it contains no working credentials.

# Public edge
A3_DOMAIN=a3.example.com
ACME_EMAIL=ops@example.com
A3_IMAGE_TAG=local

# Application security
ENVIRONMENT=production
LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
SECRET_KEY=
CORS_ORIGINS=https://a3.example.com
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Managed PostgreSQL 16. URL-encode special characters in credentials.
DATABASE_URL=postgresql+asyncpg://a3_app:replace-me@postgres.example.com:5432/agenticubed?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg://a3_app:replace-me@postgres.example.com:5432/agenticubed?sslmode=require
# Standard libpq URL used only by the backup helper.
DATABASE_BACKUP_URL=postgresql://a3_backup:replace-me@postgres.example.com:5432/agenticubed?sslmode=require
# Intentionally blank. Set only for an explicit, confirmed restore operation.
DATABASE_RESTORE_URL=

# Managed Redis 7. Use TLS and an ACL-scoped account.
REDIS_URL=rediss://a3_app:replace-me@redis.example.com:6379/0?ssl_cert_reqs=required
CELERY_BROKER_URL=rediss://a3_app:replace-me@redis.example.com:6379/1?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://a3_app:replace-me@redis.example.com:6379/2?ssl_cert_reqs=required

# Runtime
EVENT_BUS_BACKEND=redis
WORKFLOW_ENGINE_BACKEND=celery
ARTIFACT_STORE_BACKEND=local
ARTIFACT_STORE_PATH=/var/artifacts
SCHEDULER_MAX_PARALLEL=3
HANDOFF_BUDGET_CHARS=8000
TOOL_MAX_ITERATIONS=4
TOOL_MAX_CALLS=8

# Provider credentials remain optional when DEFAULT_PROVIDER=mock.
DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
