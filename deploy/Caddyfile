{
	email {$ACME_EMAIL}
	admin off
}

# Single-domain TLS termination for the production Compose profile.
# Caddy provisions and renews certificates automatically for SITE_ADDRESS.
# /metrics remains private on the Compose network by design.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@backend path /api/v1/* /healthz /readyz
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
