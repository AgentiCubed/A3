# ── AgentiCubed PRODUCTION environment template ───────────────────────────
# Copy to .env.prod and fill in. NEVER commit a real .env.prod.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Full guide: docs/DEPLOYMENT.md

# The public domain Caddy serves and provisions TLS for (DNS A record must
# point at this host BEFORE first boot, or certificate issuance fails).
SITE_ADDRESS=a3.example.com
ACME_EMAIL=ops@example.com

# Core — the app REFUSES to start in production unless SECRET_KEY is set to a
# strong value: blank, the development default, and anything shorter than 32
# characters are all rejected at startup.
# Generate one:  openssl rand -hex 32
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Same-origin deployment: the only browser origin is the site itself.
CORS_ORIGINS=https://a3.example.com

# Database (PostgreSQL) — MANAGED SERVICE RECOMMENDED (the audit trail lives
# here). TLS is required for external services; URL-encode credentials.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Plain libpq URLs used only by the backup/restore helpers.
DATABASE_BACKUP_URL=postgresql://BACKUP_USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Intentionally blank. Set only for an explicit, approved restore target.
DATABASE_RESTORE_URL=
# Only used by the optional --profile local-db services:
POSTGRES_USER=agenticubed
POSTGRES_PASSWORD=
POSTGRES_DB=agenticubed

# Redis (event bus + Celery broker/results) — managed service recommended.
REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0?ssl_cert_reqs=required
CELERY_BROKER_URL=rediss://USER:PASSWORD@HOST:6379/1?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://USER:PASSWORD@HOST:6379/2?ssl_cert_reqs=required

# Artifact storage (local volume in the compose profile)
ARTIFACT_STORE_BACKEND=local
ARTIFACT_STORE_PATH=/var/artifacts

# Model providers — referenced by KEY from agent config, resolved at call
# time, never persisted. Leave blank until an org supplies real credentials.
# GitHub Models is the free tier CI proves nightly; Anthropic/others are
# bring-your-own-key.
GITHUB_MODELS_TOKEN=
ANTHROPIC_API_KEY=
DEFAULT_PROVIDER=mock
