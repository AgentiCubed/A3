# ── AgentiCubed PRODUCTION environment template ───────────────────────────
# Copy to .env.prod, run `chmod 600 .env.prod`, and fill it in.
# NEVER commit a real .env.prod.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Full guide: docs/DEPLOYMENT.md

# The public domain Caddy serves and provisions TLS for (DNS A record must
# point at this host BEFORE first boot, or certificate issuance fails).
SITE_ADDRESS=a3.example.com
A3_IMAGE_TAG=local

# Core — the app REFUSES to start in production unless SECRET_KEY is set to a
# strong value: blank, the development default, and anything shorter than 32
# characters are all rejected at startup.
# Generate one:  openssl rand -hex 32
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Registration policy — a hosted instance is reachable by the whole internet,
# so self-registration is CLOSED by default here. Either flip it on briefly to
# create your own account, or set an invite code and register with it. The
# auth endpoints are also rate limited per client IP (0 disables).
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=
AUTH_RATE_LIMIT_PER_MINUTE=10

# Env-var keys agent configs may reference as api_key_ref. Anything not
# listed is refused at agent registration AND at call time, so user-supplied
# config can never read arbitrary server env vars.
ALLOWED_CREDENTIAL_REFS=GEMINI_API_KEY,ANTHROPIC_API_KEY,OLLAMA_API_KEY
# Same-origin deployment: the only browser origin is the site itself.
CORS_ORIGINS=https://a3.example.com

# Database (PostgreSQL) — MANAGED SERVICE RECOMMENDED (the audit trail lives
# here). Paste the provider's connection string into both URLs (async driver
# for the app, sync driver for Alembic migrations).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL_SYNC=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Standard libpq URL used only by the backup helper.
DATABASE_BACKUP_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Intentionally blank. Set only for an explicit, confirmed restore operation.
DATABASE_RESTORE_URL=
# Only used by the optional --profile local-db services:
POSTGRES_USER=agenticubed
POSTGRES_PASSWORD=
POSTGRES_DB=agenticubed

# Redis (event bus + Celery broker/results) — managed service recommended.
REDIS_URL=redis://HOST:6379/0
CELERY_BROKER_URL=redis://HOST:6379/1
CELERY_RESULT_BACKEND=redis://HOST:6379/2

# Artifact storage (local volume in the compose profile)
ARTIFACT_STORE_BACKEND=local
ARTIFACT_STORE_PATH=/var/artifacts
SCHEDULER_MAX_PARALLEL=3
HANDOFF_BUDGET_CHARS=8000
TOOL_MAX_ITERATIONS=4
TOOL_MAX_CALLS=8

# Model providers — referenced by KEY from agent config, resolved at call
# time, never persisted. Leave blank until an org supplies real credentials.
# Gemini (Google AI Studio, aistudio.google.com) is the default live
# provider and the free tier CI proves nightly; note the free tier may use
# prompts to improve Google's models, so confidential workloads belong on a
# paid tier or a local provider. Anthropic/others are bring-your-own-key.
# (GitHub Models, the previous default, was retired by GitHub 2026-07-30.)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
DEFAULT_PROVIDER=mock
